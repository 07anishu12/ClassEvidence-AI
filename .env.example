# ==============================================================================
# Humaniti AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or self-hosting:
#   cp .env.example .env.local
#
# ZERO-LEAKAGE SECURITY POLICY:
# - Never commit real credentials, tokens, or API keys into source control.
# - The default configuration enforces ASSESSMENT_PROVIDER="blocked", preventing
#   any outbound transmission of class recordings or transcript data.
# - All media artifacts are stored locally in PRIVATE_MEDIA_ROOT with 0700 permissions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Environment
# ------------------------------------------------------------------------------
NODE_ENV="development"
APP_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Default local connection (trust auth on loopback 127.0.0.1):
DATABASE_URL="postgresql://humaniti@localhost:5432/humaniti_ai?schema=public"

# For password-protected or external PostgreSQL deployments:
# POSTGRES_USER="humaniti"
# POSTGRES_PASSWORD="change_this_to_a_secure_password"
# POSTGRES_DB="humaniti_ai"
# DATABASE_URL="postgresql://humaniti:change_this_to_a_secure_password@localhost:5432/humaniti_ai?schema=public"

# ------------------------------------------------------------------------------
# 3. Assessment Provider Security Policy
# ------------------------------------------------------------------------------
# Mode choices: "blocked" (safe default) | "local" (offline model inference)
# - "blocked": Enforces hard rejection of model inference; reports technical limitations.
# - "local": Uses local offline LLM / speech tools (LOCAL_MODEL & WHISPER_MODEL_PATH).
# Remote third-party cloud AI APIs are strictly rejected without documented approval.
ASSESSMENT_PROVIDER="blocked"

# ------------------------------------------------------------------------------
# 4. Access Control & API Protection
# ------------------------------------------------------------------------------
# Required before exposing assessment retrieval or reports on a network.
# Must be at least 32 random characters (generate locally with: openssl rand -hex 32).
# ASSESSMENT_ACCESS_TOKEN="your_secure_random_32_to_256_character_token_here"

# ------------------------------------------------------------------------------
# 5. Private Media Storage & Processing Limits
# ------------------------------------------------------------------------------
# Local directory on private disk for video uploads, audio extraction, and scratch work.
# The application automatically restricts directory permissions to 0700.
PRIVATE_MEDIA_ROOT="./.private/media"

# Maximum upload file size in bytes (default: 2147483648 = 2 GiB)
MAX_UPLOAD_BYTES="2147483648"

# Maximum recording duration in seconds (default: 7200 = 2 hours)
# MAX_RECORDING_SECONDS="7200"

# ------------------------------------------------------------------------------
# 6. Offline AI Runtimes (Required only when ASSESSMENT_PROVIDER="local")
# ------------------------------------------------------------------------------
# Offline model identifier (e.g., Ollama model tag or local engine)
# LOCAL_MODEL="qwen3:4b"

# Absolute path to local ggml Whisper model file for offline speech-to-text
# WHISPER_MODEL_PATH="/absolute/private/path/to/ggml-model.bin"

# Resource & timeout limits for offline model processing
# LOCAL_MODEL_TIMEOUT_MS="120000"
# LOCAL_MODEL_MAX_OUTPUT_TOKENS="4000"

# ------------------------------------------------------------------------------
# 7. Background Worker & Retention Lifecycle
# ------------------------------------------------------------------------------
# Path to Python 3 executable supporting media pipeline (worker package)
# PYTHON_EXECUTABLE="python3"

# Data retention window for completed or failed job records (1-365 days, default: 30)
# Unlinked media files are removed immediately upon completion or cancellation.
# REPORT_RETENTION_DAYS="30"

# ------------------------------------------------------------------------------
# 8. Feature Ingestion Flags
# ------------------------------------------------------------------------------
# Enable or disable intake ingestion routes in the UI
URL_IMPORT_ENABLED="false"
DRIVE_IMPORT_ENABLED="false"
